<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource BackgroundBrush}">
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="218" />
    <ColumnDefinition Width="*" />
  </Grid.ColumnDefinitions>
  <Grid.RowDefinitions>
    <RowDefinition Height="70" />
    <RowDefinition Height="*" />
    <RowDefinition Height="30" />
  </Grid.RowDefinitions>
  <Border Grid.RowSpan="3" Background="#10233F">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="16,24,12,26">
        <StackPanel Orientation="Horizontal">
          <Image Source="../../assets/xmg-adb-logo-v2.png" Width="40" Height="40" Margin="0,0,8,0" />
          <TextBlock Text="XMG_ADB" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="设备运维工作台" Foreground="#AEC1DB" Margin="8,8,0,0" />
      </StackPanel>
      <RadioButton x:Name="SettingsNav" DockPanel.Dock="Bottom" Style="{DynamicResource NavButton}" GroupName="Navigation" Margin="8,8,8,20">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="18" Width="34" />
          <TextBlock Text="设置" Foreground="White" FontSize="14" />
        </StackPanel>
      </RadioButton>
      <StackPanel x:Name="Navigation" />
    </DockPanel>
  </Border>
  <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="26,0">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="AdbDot" Width="8" Height="8" Margin="0,0,8,0" />
        <TextBlock x:Name="AdbStatus" VerticalAlignment="Center" />
      </StackPanel>
      <Grid Grid.Column="1" MaxWidth="560" VerticalAlignment="Center">
        <ComboBox x:Name="DeviceSelector" HorizontalAlignment="Stretch" DisplayMemberPath="Display" AutomationProperties.Name="当前操作设备" />
        <TextBlock Text="尚未选择设备" IsHitTestVisible="False" Margin="12,0,32,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem, ElementName=DeviceSelector}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
      <Button x:Name="ThemeButton" Grid.Column="2" Content="切换主题" Margin="18,0,0,0" VerticalAlignment="Center" />
    </Grid>
  </Border>
  <ContentControl x:Name="PageContent" Grid.Column="1" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
  <Grid Grid.Column="1" Grid.Row="2" Margin="26,0">
    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
    <ProgressBar x:Name="BusyBar" Width="130" Height="3" HorizontalAlignment="Right" IsIndeterminate="True" Visibility="Collapsed" />
  </Grid>
  <Border x:Name="StartupOverlay" Grid.ColumnSpan="2" Grid.RowSpan="3" Background="#10233F" Panel.ZIndex="100" AutomationProperties.Name="XMG_ADB 正在启动">
    <Grid>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
        <Image x:Name="StartupLogo" Source="../../assets/xmg-adb-logo-v2.png" Width="92" Height="92" HorizontalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
          <Image.RenderTransform>
            <TranslateTransform Y="14" />
          </Image.RenderTransform>
        </Image>
        <TextBlock x:Name="StartupTitle" Text="XMG_ADB" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,0" Opacity="0" />
        <TextBlock x:Name="StartupSubtitle" Text="设备运维工作台" Foreground="#AEC1DB" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0" />
        <Border Width="180" Height="3" Background="#29425F" CornerRadius="2" Margin="0,28,0,0">
          <Border x:Name="StartupProgress" Background="#4D8DFF" CornerRadius="2" RenderTransformOrigin="0,0.5">
            <Border.RenderTransform>
              <ScaleTransform ScaleX="0" />
            </Border.RenderTransform>
          </Border>
        </Border>
      </StackPanel>
    </Grid>
  </Border>
</Grid>
