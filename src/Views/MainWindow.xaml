<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource BackgroundBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border Grid.RowSpan="3" Background="#10233F"><DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="22,24,12,28"><TextBlock Text="XMG_ADB" Foreground="White" FontSize="24" FontWeight="Bold"/><TextBlock Text="设备运维工作台" Foreground="#AEC1DB" Margin="0,7,0,0"/></StackPanel>
    <RadioButton x:Name="SettingsNav" DockPanel.Dock="Bottom" Content="&#xE713;     设置" FontFamily="Segoe MDL2 Assets, Microsoft YaHei UI" Style="{DynamicResource NavButton}" GroupName="Navigation" Margin="8,8,8,20"/>
    <StackPanel x:Name="Navigation"/>
  </DockPanel></Border>
  <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="26,0"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="AdbDot" Width="8" Height="8" Margin="0,0,8,0"/><TextBlock x:Name="AdbStatus" VerticalAlignment="Center"/></StackPanel>
    <ComboBox x:Name="DeviceSelector" Grid.Column="1" MaxWidth="560" HorizontalAlignment="Stretch" VerticalAlignment="Center" DisplayMemberPath="Display" AutomationProperties.Name="当前操作设备"/>
    <Button x:Name="ThemeButton" Grid.Column="2" Content="切换主题" Margin="18,0,0,0" VerticalAlignment="Center"/>
  </Grid></Border>
  <ContentControl x:Name="PageContent" Grid.Column="1" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <Grid Grid.Column="1" Grid.Row="2" Margin="26,0"><TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/><ProgressBar x:Name="BusyBar" Width="130" Height="3" HorizontalAlignment="Right" IsIndeterminate="True" Visibility="Collapsed"/></Grid>
</Grid>
