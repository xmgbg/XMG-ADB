<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="28,24">
    <TextBlock Text="设置" Style="{DynamicResource PageTitle}" />
    <TextBlock Text="配置外部工具、默认目录、日志容量与应用主题。" Style="{DynamicResource Subtitle}" />
    <Border Style="{DynamicResource Card}">
      <StackPanel>
        <TextBlock Text="外部工具与目录" Style="{DynamicResource SectionTitle}" />
        <TextBlock Text="ADB 可执行文件" Margin="0,0,0,8" />
        <DockPanel Margin="0,0,0,20">
          <Button x:Name="ChooseAdb" Content="选择 ADB" DockPanel.Dock="Right" Margin="12,0,0,0" />
          <TextBox x:Name="AdbPath" AutomationProperties.Name="ADB 可执行文件" />
        </DockPanel>
        <TextBlock Text="scrcpy 可执行文件（可选）" Margin="0,0,0,8" />
        <DockPanel Margin="0,0,0,20">
          <Button x:Name="ChooseScrcpy" Content="选择 scrcpy" DockPanel.Dock="Right" Margin="12,0,0,0" />
          <TextBox x:Name="ScrcpyPath" AutomationProperties.Name="scrcpy 可执行文件" />
        </DockPanel>
        <TextBlock Text="默认保存目录" Margin="0,0,0,8" />
        <DockPanel>
          <Button x:Name="ChooseFolder" Content="选择目录" DockPanel.Dock="Right" Margin="12,0,0,0" />
          <TextBox x:Name="DefaultFolder" AutomationProperties.Name="默认保存目录" />
        </DockPanel>
      </StackPanel>
    </Border>
    <Border Style="{DynamicResource Card}" Margin="0,16,0,16">
      <WrapPanel>
        <StackPanel Margin="0,0,32,0">
          <TextBlock Text="日志缓冲行数（1000 至 200000）" Margin="0,0,0,8" />
          <TextBox x:Name="LogBuffer" Width="220" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="应用主题" Margin="0,0,0,8" />
          <ComboBox x:Name="Theme" Width="180" />
        </StackPanel>
      </WrapPanel>
    </Border>
    <WrapPanel>
      <Button x:Name="Save" Content="保存设置" Style="{DynamicResource PrimaryButtonStyle}" />
      <Button x:Name="Detect" Content="重新检测 ADB" />
      <Button x:Name="OpenFolder" Content="打开数据目录" />
    </WrapPanel>
    <TextBlock x:Name="Status" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
  </StackPanel>
</ScrollViewer>