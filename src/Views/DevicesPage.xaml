<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="28,24">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="*" />
  </Grid.RowDefinitions>
  <StackPanel>
    <TextBlock Text="设备连接" Style="{DynamicResource PageTitle}" />
    <TextBlock Text="连接 USB 或网络设备，所选设备将同步到所有功能页。" Style="{DynamicResource Subtitle}" />
  </StackPanel>
  <Border Grid.Row="1" Style="{DynamicResource Card}" Margin="0,0,0,12">
    <WrapPanel VerticalAlignment="Bottom">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="设备 IP / 地址" Margin="0,0,0,6" />
        <ComboBox x:Name="Address" Width="220" IsEditable="True" />
      </StackPanel>
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="端口" Margin="0,0,0,6" />
        <TextBox x:Name="Port" Text="5555" Width="76" />
      </StackPanel>
      <Button x:Name="Connect" Content="连接" Style="{DynamicResource PrimaryButtonStyle}" VerticalAlignment="Bottom" Margin="0,0,8,0" />
      <Button x:Name="Refresh" Content="刷新设备" VerticalAlignment="Bottom" Margin="0,0,8,0" />
      <Button x:Name="Restart" Content="重启 ADB" VerticalAlignment="Bottom" Margin="0" />
    </WrapPanel>
  </Border>
  <Border Grid.Row="2" Style="{DynamicResource Card}" Margin="0,0,0,12">
    <WrapPanel>
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="无线配对地址" Margin="0,0,0,6" />
        <TextBox x:Name="PairAddress" Width="220" Text="192.168.1.100:37000" />
      </StackPanel>
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="六位配对码" Margin="0,0,0,6" />
        <TextBox x:Name="PairCode" Width="120" />
      </StackPanel>
      <Button x:Name="Pair" Content="配对" VerticalAlignment="Bottom" Margin="0,0,8,0" />
      <Button x:Name="Help" Content="配对说明" VerticalAlignment="Bottom" Margin="0" />
    </WrapPanel>
  </Border>
  <Grid Grid.Row="3">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="280" />
    </Grid.ColumnDefinitions>
    <ListView x:Name="Devices" SelectionMode="Extended" Margin="0,0,12,0">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="设备" Width="150" DisplayMemberBinding="{Binding Model}" />
          <GridViewColumn Header="地址 / 序列号" Width="190" DisplayMemberBinding="{Binding Serial}" />
          <GridViewColumn Header="状态" Width="90" DisplayMemberBinding="{Binding StateText}" />
        </GridView>
      </ListView.View>
    </ListView>
    <Border Grid.Column="1" Style="{DynamicResource Card}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="设备详情" Style="{DynamicResource SectionTitle}" />
          <TextBlock x:Name="Details" Text="选择一台设备查看详细信息。" TextWrapping="Wrap" Margin="0,0,0,20" />
          <Button x:Name="Disconnect" Content="断开当前设备" />
          <Button x:Name="Copy" Content="复制序列号" />
          <Button x:Name="Batch" Content="断开所选网络设备" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Grid>