<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="28,24">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition Height="*" />
  </Grid.RowDefinitions>
  <StackPanel>
    <TextBlock Text="工具与诊断" Style="{DynamicResource PageTitle}" />
    <TextBlock Text="截图录屏、性能监控、诊断导出与设备镜像。" Style="{DynamicResource Subtitle}" />
  </StackPanel>
  <TabControl x:Name="Tabs" Grid.Row="1">
    <TabItem Header="截图与录屏">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
          <TextBlock Text="截图保存目录" Style="{DynamicResource SectionTitle}" />
          <DockPanel>
            <Button x:Name="ChooseFolder" Content="选择目录" DockPanel.Dock="Right" Margin="12,0,0,0" />
            <TextBox x:Name="CaptureFolder" />
          </DockPanel>
          <Button x:Name="Screenshot" Content="截取当前屏幕" Style="{DynamicResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,16,0,24" />
          <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,24" />
          <TextBlock Text="屏幕录制" Style="{DynamicResource SectionTitle}" />
          <TextBlock Text="设备端保存路径" Margin="0,0,0,8" />
          <TextBox x:Name="RecordRemote" Text="/sdcard/xmg-adb-screen.mp4" />
          <WrapPanel Margin="0,16,0,8">
            <Button x:Name="RecordStart" Content="开始录制" />
            <Button x:Name="RecordStop" Content="停止并拉取" />
          </WrapPanel>
          <TextBlock x:Name="CaptureStatus" Text="录屏最长 180 秒，停止后自动拉取到保存目录。" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="性能监控">
      <Grid Margin="24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="包名（可选，留空查看系统）" Margin="0,0,0,8" />
          <DockPanel Margin="0,0,0,16">
            <WrapPanel DockPanel.Dock="Right" Margin="12,0,0,0">
              <Button x:Name="MonitorStart" Content="开始监控" Style="{DynamicResource PrimaryButtonStyle}" />
              <Button x:Name="MonitorStop" Content="停止" />
            </WrapPanel>
            <TextBox x:Name="PerformancePackage" />
          </DockPanel>
        </StackPanel>
        <TextBox x:Name="PerformanceOutput" Grid.Row="1" Style="{DynamicResource ConsoleText}" IsReadOnly="True" />
      </Grid>
    </TabItem>
    <TabItem Header="诊断导出">
      <StackPanel Margin="24">
        <TextBlock Text="诊断资料" Style="{DynamicResource SectionTitle}" />
        <TextBlock Text="快速快照包含设备属性、电量、存储、网络和最近错误日志。完整 Bugreport 可能需要数分钟。" Style="{DynamicResource Subtitle}" />
        <WrapPanel>
          <Button x:Name="Snapshot" Content="导出快速快照" Style="{DynamicResource PrimaryButtonStyle}" />
          <Button x:Name="Bugreport" Content="生成完整 Bugreport" />
          <Button x:Name="CopyProperties" Content="复制设备属性" />
        </WrapPanel>
      </StackPanel>
    </TabItem>
    <TabItem Header="批量脚本">
      <Grid Margin="24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="3*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="脚本预设" Margin="0,0,0,8" />
          <WrapPanel Margin="0,0,0,14">
            <ComboBox x:Name="ScriptPreset" Width="210" Margin="0,0,16,0" />
            <CheckBox x:Name="ScriptAllDevices" Content="在全部设备上执行" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button x:Name="RunScript" Content="执行脚本" Style="{DynamicResource PrimaryButtonStyle}" Margin="0" />
          </WrapPanel>
        </StackPanel>
        <TextBox x:Name="ScriptEditor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        <TextBlock Grid.Row="2" Text="执行输出" Margin="0,14,0,8" />
        <TextBox x:Name="ScriptOutput" Grid.Row="3" Style="{DynamicResource ConsoleText}" IsReadOnly="True" />
      </Grid>
    </TabItem>
    <TabItem Header="设备镜像">
      <StackPanel Margin="24">
        <TextBlock Text="设备镜像" Style="{DynamicResource SectionTitle}" />
        <TextBlock Text="指定可选外部组件 scrcpy.exe，为当前设备启动镜像和控制。" Style="{DynamicResource Subtitle}" />
        <TextBlock Text="scrcpy 可执行文件" Margin="0,0,0,8" />
        <DockPanel>
          <Button x:Name="ChooseScrcpy" Content="选择 scrcpy" DockPanel.Dock="Right" Margin="12,0,0,0" />
          <TextBox x:Name="ScrcpyPath" />
        </DockPanel>
        <Button x:Name="LaunchMirror" Content="启动设备镜像" Style="{DynamicResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,20,0,0" />
      </StackPanel>
    </TabItem>
  </TabControl>
</Grid>