<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions><StackPanel><TextBlock Text="实时日志" Style="{DynamicResource PageTitle}"/><TextBlock Text="按级别、Tag、进程和文本过滤设备日志。" Style="{DynamicResource Subtitle}"/></StackPanel>
<Border Grid.Row="1" Style="{DynamicResource Card}" Margin="0,0,0,12"><StackPanel><WrapPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="日志级别"/><ComboBox x:Name="Level" Width="110" Margin="0,6,0,0"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="Tag"/><TextBox x:Name="Tag" Width="140" Margin="0,6,0,0"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="PID / 包名"/><TextBox x:Name="Process" Width="180" Margin="0,6,0,0"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="搜索文本"/><TextBox x:Name="Search" Width="180" Margin="0,6,0,0"/></StackPanel></WrapPanel><WrapPanel><Button x:Name="Start" Content="开始" Style="{DynamicResource PrimaryButtonStyle}"/><Button x:Name="Pause" Content="暂停 / 继续"/><Button x:Name="Clear" Content="清空"/><Button x:Name="Export" Content="导出"/><Button x:Name="Cache" Content="导出设备缓存"/></WrapPanel></StackPanel></Border>
<RichTextBox x:Name="Log" Grid.Row="2" IsReadOnly="True" IsUndoEnabled="False" FontFamily="Consolas" FontSize="13" Padding="16" Background="{DynamicResource LogBackgroundBrush}" Foreground="{DynamicResource LogTextBrush}" BorderBrush="{DynamicResource BorderBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><FlowDocument PagePadding="0" LineHeight="19"/></RichTextBox><TextBlock x:Name="Stats" Text="未启动" Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/></Grid>
