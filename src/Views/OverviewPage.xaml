<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Margin="28,24">
  <TextBlock Text="设备概览" Style="{DynamicResource PageTitle}"/><TextBlock Text="查看当前设备，快速执行常用任务。" Style="{DynamicResource Subtitle}"/>
  <Border Style="{DynamicResource Card}"><StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="DeviceName" Text="尚未连接设备" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="DeviceState" Text="使用 USB 连接设备，或前往设备连接进行无线配对。" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,16,20" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="Refresh" Content="刷新设备" Style="{DynamicResource PrimaryButtonStyle}"/><Button x:Name="Connect" Content="设备连接"/></StackPanel></Grid>
   <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="18"><UniformGrid Columns="4"><StackPanel><TextBlock Text="Android 版本" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="Android" Text="暂无数据" FontSize="22" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel><StackPanel><TextBlock Text="电量" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="Battery" Text="暂无数据" FontSize="22" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel><StackPanel><TextBlock Text="可用存储 /data" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="Storage" Text="暂无数据" FontSize="22" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel><StackPanel><TextBlock Text="电池温度" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="Temperature" Text="暂无数据" FontSize="22" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel></UniformGrid></Border>
   <TextBlock x:Name="ReadStatus" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
  </StackPanel></Border>
  <Grid Margin="0,16,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
   <Border Style="{DynamicResource Card}" Margin="0,0,16,0"><StackPanel><TextBlock Text="快捷操作" Style="{DynamicResource SectionTitle}"/><UniformGrid Columns="2"><Button x:Name="Install" Content="安装 APK" Height="58" HorizontalContentAlignment="Left"/><Button x:Name="Transfer" Content="传输文件" Height="58" HorizontalContentAlignment="Left"/><Button x:Name="Capture" Content="截图与录屏" Height="58" HorizontalContentAlignment="Left"/><Button x:Name="Mirror" Content="设备镜像" Height="58" HorizontalContentAlignment="Left"/></UniformGrid></StackPanel></Border>
   <Border Grid.Column="1" Style="{DynamicResource Card}"><StackPanel><TextBlock Text="设备诊断" Style="{DynamicResource SectionTitle}"/><TextBlock Text="性能监控、诊断快照与批量脚本集中在工具页，按需运行。" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/><Button x:Name="Diagnostics" Content="打开工具与诊断" HorizontalAlignment="Left"/></StackPanel></Border>
  </Grid>
  <Border Style="{DynamicResource Card}"><StackPanel><TextBlock Text="近期任务" Style="{DynamicResource SectionTitle}"/><TextBlock x:Name="EmptyHistory" Text="暂无操作记录，执行任务后将在此显示。" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/><ListView x:Name="History" BorderThickness="0" MaxHeight="215"><ListView.View><GridView><GridViewColumn Header="操作" Width="180" DisplayMemberBinding="{Binding Action}"/><GridViewColumn Header="目标设备" Width="230" DisplayMemberBinding="{Binding Device}"/><GridViewColumn Header="时间" Width="180" DisplayMemberBinding="{Binding Time, StringFormat=MM-dd HH:mm:ss}"/><GridViewColumn Header="结果" Width="90" DisplayMemberBinding="{Binding Status}"/></GridView></ListView.View></ListView></StackPanel></Border>
 </StackPanel>
</ScrollViewer>
